# Root gitignore for DevPulse Engineer Assistant

# Environment and Secrets (CRITICAL: NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key
id_rsa
secrets.json

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Build outputs & Cache
dist/
build/
.next/
.expo/
.expo-shared/
web-build/
.cache/
*.tsbuildinfo
coverage/

# React Native / Expo native projects (generated by prebuild)
/mobile/android/
/mobile/ios/
*.apk
*.aab
*.ipa

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tool state
.claude/
